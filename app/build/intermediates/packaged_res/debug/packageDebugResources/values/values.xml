    <style name="CartaoStat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@color/branco</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
        <item name="android:elevation">2dp</item>
    </style>
    <style name="TextoStatRotulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="TextoStatValor">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/azul_primario</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Theme.TaskFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/azul_primario</item>
        <item name="colorOnPrimary">@color/branco</item>
        <item name="colorPrimaryDark">@color/azul_escuro</item>
        <item name="colorSecondary">@color/amarelo_curso</item>
        <item name="android:colorBackground">@color/fundo</item>
        <item name="android:statusBarColor">@color/azul_escuro_bg</item>
    </style>
